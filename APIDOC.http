# DOCTORS 

# api call for listing doctors 

###
GET http://127.0.0.1:8000/doctors/
Accept: application/json


# api call for creating doctor

###
POST http://127.0.0.1:8000/doctors/
Content-Type: application/json

{
    "name":"ajith",
    "specialization":"uro",
    "fee":1000,
    "qualification":"mbbs",
    "email":"ajith@gamil.com"
}

# api call for listing specific doctor

###
GET http://127.0.0.1:8000/doctors/2/
Accept: application/json

###
PUT http://127.0.0.1:8000/doctors/2/
Content-Type: application/json

{
    "name": "naveen",
    "specialization": "urology",
    "fee": 1200,
    "qualification": "mbbs",
    "email": "naveen@gamil.com"
}

# api call for deleting doctor

###
DELETE http://127.0.0.1:8000/doctors/2/
Accept: application/json


# staff_v2

# api call for listing doctors 

###
GET http://127.0.0.1:8000/v2/doctors/
Accept: application/json
Authorization: Basic superuser:superuser

# api call for creating doctor

###
POST http://127.0.0.1:8000/v2/doctors/
Content-Type: application/json

{
    "name":"anaghesh",
    "specialization":"uro",
    "fee":1000,
    "qualification":"mbbs",
    "email":"anaghesh@gamil.com"
}

# api call for listing specific doctor

###
GET http://127.0.0.1:8000/v2/doctors/3/
Accept: application/json

# api call for updating


###
PUT http://127.0.0.1:8000/v2/doctors/3/
Content-Type: application/json

{
    "id":3,
    "name": "anaghesh k a",
    "specialization": "urology",
    "fee": 900,
    "qualification": "mbbs",
    "email": "anaghesh@gamil.com"
}

# api call for creating admin

###
POST http://127.0.0.1:8000/v2/admin-register/
Content-Type: application/json

{
    "username":"superuser",
    "email":"superuser@gmail.com",
    "password":"superuser"
}


# APPOINTMENTS ===================================


#api call for listing all appointments

###
GET  http://127.0.0.1:8000/appointments/
Accept: application/json


# api call for creating appointments

###
POST http://127.0.0.1:8000/appointments/
Content-Type: application/json

{
    "patient_name":"Ajay",
    "phone":"123456789",
    "doctor":1,
    "appointment_date":"2026-10-11",
    "problem":"cold"
}



# booking_v2 ================================

# user register api
###
POST http://127.0.0.1:8000/v2/booking/signup/
Content-Type: application/json

{
    "username":"django",
    "email":"django@gmail.com",
    "password":"django"
}

# api call for listing bookings
###
GET http://127.0.0.1:8000/v2/booking/appointments/
Accept: application/json
Authorization: Basic django:django

# api call for creating booking

###
POST http://127.0.0.1:8000/v2/booking/appointments/
Content-Type: application/json
Authorization: Basic django:django

{
    "patient_name":"gowtham",
    "phone":"123456780",
    "doctor":1,
    "appointment_date":"2026-10-21",
    "problem":"weezing"
}

# api call for specific appointments
###
GET http://127.0.0.1:8000/v2/booking/appointments/13/
Accept: application/json
Authorization: Basic django:django

# api call for updating appointments
###
PUT http://127.0.0.1:8000/v2/booking/appointments/13/
Content-Type: application/json
Authorization: Basic django:django

{
  "id": 13,
  "patient_name": "basil joseph",
  "phone": "123456782",
  "appointment_date": "2026-10-21",
  "token_number": 1,
  "appointment_time": "10:00:00",
  "problem": "weezing",
  "created_at": "2026-10-07T05:48:47.403119Z",
  "doctor": 1  
}

# api call for deleting appointments
###
DELETE http://127.0.0.1:8000/v2/booking/appointments/9/
Accept: application/json
Authorization: Basic django:django